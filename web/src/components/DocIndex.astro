---
import { getSections } from "../lib/brand";

const sections = getSections();
---

<div class="not-prose space-y-12">
  {
    sections.map((section) => (
      <section aria-labelledby={`${section.id}-heading`}>
        <h2
          id={`${section.id}-heading`}
          class="font-serif text-2xl font-bold tracking-tight text-ink-plum sm:text-3xl"
        >
          {section.name}
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {section.items.map((doc) => (
            <li>
              <a
                href={`/${doc.path}`}
                class="block h-full rounded-2xl border border-pale-lavender bg-white p-5 transition-colors hover:border-vibrant-purple/60 hover:bg-pale-lavender/40"
              >
                <span class="font-serif text-lg font-bold text-ink-plum">
                  {doc.title}
                </span>
                <span class="mt-1 block text-xs uppercase tracking-widest text-ink-plum/40">
                  {doc.sectionName}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
