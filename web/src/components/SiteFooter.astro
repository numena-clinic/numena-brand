---
import { getSiteName } from "../lib/brand";
const siteName = getSiteName();
---

<footer class="mt-24 border-t border-pale-lavender bg-pale-lavender/30">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-8 text-sm text-charcoal/70 sm:px-8"
  >
    <p>
      {siteName} — every page is rendered from the source documents in
      <a
        class="text-deep-purple underline underline-offset-4"
        href="https://github.com/numena-clinic/numena-brand/tree/main/docs"
        >docs/</a
      >. Where this site and a source differ, the source wins.
    </p>
    <p class="text-charcoal/50">
      Logos © Numena. Web type: Tiempos (Klim, licensed, not redistributed) and
      Albert Sans (SIL OFL 1.1).
    </p>
  </div>
</footer>
