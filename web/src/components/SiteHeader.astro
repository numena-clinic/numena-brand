---
import { getSections } from "../lib/brand";

const sections = getSections();
const current = Astro.url.pathname.replace(/^\/|\/$/g, "");
---

<header class="sticky top-0 z-40 border-b border-pale-lavender/70 bg-white/90 backdrop-blur">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-2 gap-y-1 px-5 py-3 sm:px-8"
  >
    <a href="/" class="mr-2 flex items-center gap-2 font-serif text-lg font-bold text-ink-plum">
      <img src="/favicon.svg" alt="" width="22" height="22" />
      Numena
    </a>

    <a
      href="/"
      class:list={[
        "rounded-full px-3 py-1.5 text-sm transition-colors hover:bg-pale-lavender hover:text-deep-purple",
        current === "" && "bg-pale-lavender text-deep-purple",
      ]}
    >
      Overview
    </a>

    {
      sections.map((section) => (
        <details class="doc-menu">
          <summary
            class:list={[
              "cursor-pointer list-none rounded-full px-3 py-1.5 text-sm transition-colors hover:bg-pale-lavender hover:text-deep-purple",
              current.startsWith(section.id) && "bg-pale-lavender text-deep-purple",
            ]}
          >
            {section.name}
          </summary>
          <ul class="doc-menu-panel">
            {section.items.map((doc) => (
              <li>
                <a
                  href={`/${doc.path}`}
                  class:list={[
                    "block rounded-lg px-3 py-1.5 text-sm text-ink-plum/80 hover:bg-pale-lavender hover:text-deep-purple",
                    current === doc.path && "bg-pale-lavender text-deep-purple",
                  ]}
                >
                  {doc.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</header>
