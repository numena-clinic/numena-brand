---
import Wrapper from "./Wrapper.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navigation = [
  { label: "Overview", href: "/", match: (p: string) => p === "/" },
  {
    label: "Brand Strategy",
    href: "/brand-strategy/",
    match: (p: string) => p.startsWith("/brand-strategy"),
  },
  {
    label: "Visual Identity",
    href: "/visual-identity/",
    match: (p: string) => p.startsWith("/visual-identity"),
  },
];
---

<header
  class="sticky top-0 z-40 border-b border-ink-plum/10 bg-white/85 backdrop-blur"
>
  <Wrapper class="flex min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2">
    <a
      href="/"
      class="flex items-center gap-3 rounded-sm py-1 outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vibrant-purple"
      aria-label="Numena brand, home"
    >
      <img
        src="/assets/logo/logo-primary.svg"
        alt="Numena"
        class="h-6 w-auto"
      />
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1">
        {
          navigation.map((item) => {
            const active = item.match(path);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-9 items-center rounded-full px-3 text-[0.6875rem] font-medium uppercase tracking-[0.16em] outline-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibrant-purple",
                    active
                      ? "bg-deep-purple text-white"
                      : "text-ink-plum/60 hover:bg-pale-lavender hover:text-deep-purple",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Wrapper>
</header>
