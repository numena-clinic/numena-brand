---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: extraClass = "", ...attributes } = Astro.props;
const classes = `mx-auto w-full max-w-7xl px-5 sm:px-8 ${extraClass}`.trim();
---

<div class={classes} {...attributes}>
  <slot />
</div>
