---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";
import { getPalette } from "../../lib/brand";

const palette = getPalette();
const groups = ["Foundation", "Expression", "Supporting tints"]
  .map((name) => ({ name, colors: palette.filter((c) => c.group === name) }))
  .filter((group) => group.colors.length > 0);
---

<section id="color" class="border-b border-ink-plum/10 bg-pale-lavender">
  <Wrapper class="py-20 md:py-28">
    <div class="flex items-start justify-between gap-6">
      <div class="flex items-baseline gap-4">
        <Text variant="meta" class="text-vibrant-purple">02</Text>
        <Text variant="meta" class="text-ink-plum/50">Color</Text>
      </div>
      <a
        href="/visual-identity/color"
        class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-deep-purple outline-none transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vibrant-purple"
      >
        Open the color system ↗
      </a>
    </div>

    <Text
      variant="display"
      class="mt-14 max-w-4xl text-deep-purple md:mt-20"
      data-reveal
    >
      Numena is recognized through deep purple, <span class="text-ink-plum"
        >grounded by ink.</span
      >
    </Text>

    <div class="mt-16 space-y-12 md:mt-20">
      {
        groups.map((group) => (
          <div>
            <Text variant="meta" class="text-ink-plum/40">
              {group.name}
            </Text>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
              {group.colors.map((color) => (
                <li class="overflow-hidden rounded-2xl border border-ink-plum/10 bg-white">
                  <div
                    class="h-24"
                    style={`background:${color.hex}`}
                    aria-hidden="true"
                  />
                  <div class="p-4">
                    <p class="text-sm font-medium text-ink-plum">
                      {color.name}
                    </p>
                    <p class="mt-1 font-mono text-xs text-deep-purple">
                      {color.hex}
                    </p>
                    <p class="mt-2 text-xs leading-snug text-ink-plum/55">
                      {color.role}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
