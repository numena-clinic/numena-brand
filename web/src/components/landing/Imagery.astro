---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";

const images = ["1", "14", "7", "10", "13"];
---

<section id="imagery" class="border-b border-ink-plum/10 bg-white">
  <Wrapper class="py-20 md:py-28">
    <div class="flex items-start justify-between gap-6">
      <div class="flex items-baseline gap-4">
        <Text variant="meta" class="text-vibrant-purple">05</Text>
        <Text variant="meta" class="text-ink-plum/50">Imagery</Text>
      </div>
      <a
        href="/visual-identity/imagery"
        class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-deep-purple outline-none transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vibrant-purple"
      >
        Open imagery ↗
      </a>
    </div>

    <Text variant="display" class="mt-14 max-w-4xl md:mt-20" data-reveal>
      Human experience, shown with <span class="text-vibrant-purple"
        >clarity and respect.</span
      >
    </Text>

    <div
      class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-6 md:mt-20"
    >
      {
        images.map((n, i) => (
          <img
            src={`/assets/images/${n}.jpg`}
            alt={`Imagery reference ${i + 1}`}
            loading="lazy"
            class:list={[
              "aspect-square w-full rounded-2xl object-cover",
              i === 0 && "col-span-2 aspect-[4/5] object-top",
              i === 1 && "col-span-2 aspect-[4/5] object-center",
              i === 2 && "col-span-2 aspect-[4/5] object-top",
              i === 3 && "col-span-2 aspect-square sm:col-span-3 object-top",
              i === 4 && "col-span-2 aspect-square sm:col-span-3 object-[50%_35%]",
            ]}
          />
        ))
      }
    </div>
  </Wrapper>
</section>
