---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";

const spaced = (value: string) => [...value].join(" ");

const upper = spaced("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
const lower = spaced("abcdefghijklmnopqrstuvwxyz");
const digits = spaced("0123456789");
const punctuation = "& ? ! @ # $ % * ( ) [ ] / —";

const faces = [
  {
    name: "Tiempos Text",
    role: "Editorial",
    family: "font-serif",
    blurb:
      "Carries editorial character — the voice behind headlines, pull quotes, and long-form reading.",
    glyph: "font-serif",
    weights: [
      { label: "Regular", className: "font-normal" },
      { label: "Medium", className: "font-medium" },
      { label: "Bold", className: "font-bold" },
    ],
    sample: "A quirky plum fox jumps by the white rabbit.",
  },
  {
    name: "Albert Sans",
    role: "Functional",
    family: "font-sans",
    blurb:
      "Everything functional — interface, labels, captions, and the operational voice of the brand.",
    glyph: "font-sans uppercase",
    weights: [
      { label: "Regular", className: "font-normal" },
      { label: "Medium", className: "font-medium" },
      { label: "Semibold", className: "font-semibold" },
      { label: "Bold", className: "font-bold" },
    ],
    sample: "A quirky plum fox jumps by the white rabbit.",
  },
];
---

<section id="typography" class="border-b border-ink-plum/10 bg-white text-ink-plum">
  <Wrapper class="py-20 md:py-28">
    <div class="flex items-start justify-between gap-6">
      <div class="flex items-baseline gap-4">
        <Text variant="meta" class="text-vibrant-purple">03</Text>
        <Text variant="meta" class="text-ink-plum/50">Typography</Text>
      </div>
      <a
        href="/visual-identity/typography"
        class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-deep-purple outline-none transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vibrant-purple"
      >
        Open typography ↗
      </a>
    </div>

    <Text variant="display" class="mt-14 max-w-4xl md:mt-20" data-reveal>
      Two typefaces, each with <span class="text-vibrant-purple">a clear job.</span>
    </Text>

    <div class="mt-16 space-y-6 md:mt-20 md:space-y-8">
      {
        faces.map((face) => (
          <div class="grid gap-10 rounded-2xl bg-deep-purple p-8 text-white md:grid-cols-12 md:gap-8 md:p-12">
            <div class="md:col-span-4">
              <Text variant="meta" class="text-white">
                {face.role}
              </Text>
              <p
                class={`mt-6 ${face.glyph} text-[clamp(4.5rem,11vw,7.5rem)] font-bold leading-[0.8] tracking-[-0.03em] text-white`}
                aria-hidden="true"
              >
                Aa
              </p>
              <p class={`mt-6 ${face.family} text-2xl font-bold text-white`}>
                {face.name}
              </p>
              <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">
                {face.blurb}
              </p>
            </div>

            <div class="md:col-span-8">
              <p
                class={`${face.family} text-[clamp(1.4rem,2.7vw,2.1rem)] leading-snug tracking-[-0.01em] text-white`}
              >
                {face.sample}
              </p>

              <div class="mt-10 space-y-3">
                {face.weights.map((weight) => (
                  <div class="flex items-baseline justify-between gap-4 border-b border-white/15 pb-2">
                    <span
                      class={`${face.family} ${weight.className} text-lg leading-snug text-white md:text-xl`}
                    >
                      {face.sample}
                    </span>
                    <Text variant="meta" class="text-white/70">
                      {weight.label}
                    </Text>
                  </div>
                ))}
              </div>


            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
