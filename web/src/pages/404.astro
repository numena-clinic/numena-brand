---
import DocLayout from "../layouts/DocLayout.astro";
---

<DocLayout title="Not found">
  <section class="mx-auto max-w-3xl px-5 py-24 sm:px-8">
    <p class="text-xs font-medium uppercase tracking-widest text-vibrant-purple">
      404
    </p>
    <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-plum">
      This page doesn't exist.
    </h1>
    <p class="mt-4 text-lg text-ink-plum/70">
      The brand documents live on the <a
        class="text-deep-purple underline underline-offset-4"
        href="/">home page</a
      >.
    </p>
  </section>
</DocLayout>
