---
import Layout from "../layouts/Layout.astro";
import Wrapper from "../components/Wrapper.astro";
import Text from "../components/Text.astro";
---

<Layout title="Not found">
  <Wrapper class="py-24 md:py-32">
    <Text variant="meta" class="text-vibrant-purple">404</Text>
    <Text variant="display" class="mt-6 max-w-2xl">
      This page doesn't exist.
    </Text>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-plum/65">
      The brand guide lives on the
      <a
        href="/"
        class="text-deep-purple underline decoration-deep-purple/30 underline-offset-4 outline-none transition-colors hover:text-vibrant-purple focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibrant-purple"
        >overview page</a
      >. You can also go straight to
      <a
        href="/brand-strategy/"
        class="text-deep-purple underline decoration-deep-purple/30 underline-offset-4 outline-none transition-colors hover:text-vibrant-purple focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibrant-purple"
        >Brand Strategy</a
      > or
      <a
        href="/visual-identity/"
        class="text-deep-purple underline decoration-deep-purple/30 underline-offset-4 outline-none transition-colors hover:text-vibrant-purple focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibrant-purple"
        >Visual Identity</a
      >.
    </p>
  </Wrapper>
</Layout>
