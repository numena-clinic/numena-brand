---
import { getDocs } from "../lib/brand";
import DocsLayout from "../layouts/DocsLayout.astro";

export function getStaticPaths() {
  return getDocs().map((doc) => ({ params: { slug: doc.path }, props: { doc } }));
}

const { doc } = Astro.props;
---

<DocsLayout
  title={doc.title}
  current={doc.path}
  sectionId={doc.sectionId}
  sectionName={doc.sectionName}
  docTitle={doc.title}
>
  <article class="prose" set:html={doc.html} />
</DocsLayout>
